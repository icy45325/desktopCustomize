BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ChatDemo//Team Sample//ZH
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:团队公共日历
X-WR-TIMEZONE:Asia/Shanghai
BEGIN:VEVENT
UID:allhands@team.example
DTSTART;TZID=Asia/Shanghai:20260108T160000
DTEND;TZID=Asia/Shanghai:20260108T170000
RRULE:FREQ=WEEKLY;BYDAY=TH
SUMMARY:全员周会
LOCATION:大会议室 / 线上
DESCRIPTION:议程：\n1. 本周进展\n2. 风险\, 依赖与求助\n3. 下周计划
END:VEVENT
BEGIN:VEVENT
UID:allhands@team.example
RECURRENCE-ID;TZID=Asia/Shanghai:20261126T160000
DTSTART;TZID=Asia/Shanghai:20261127T150000
DTEND;TZID=Asia/Shanghai:20261127T160000
SUMMARY:全员周会（本周改到周五）
LOCATION:大会议室 / 线上
END:VEVENT
BEGIN:VEVENT
UID:monthly-review@team.example
DTSTART;TZID=Asia/Shanghai:20260130T170000
DURATION:PT1H
RRULE:FREQ=MONTHLY;BYDAY=-1FR
SUMMARY:月度复盘
DESCRIPTION:每月最后一个周五。
END:VEVENT
BEGIN:VEVENT
UID:sprint-planning@team.example
DTSTART;TZID=Asia/Shanghai:20260105T150000
DTEND;TZID=Asia/Shanghai:20260105T163000
RRULE:FREQ=WEEKLY;INTERVAL=2;BYDAY=MO
EXDATE;TZID=Asia/Shanghai:20261207T150000
SUMMARY:迭代规划
LOCATION:2F 会议室 C
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT15M
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:anniversary@team.example
DTSTART;VALUE=DATE:20161208
DTEND;VALUE=DATE:20161209
RRULE:FREQ=YEARLY
SUMMARY:公司周年庆
END:VEVENT
BEGIN:VEVENT
UID:global-sync@team.example
DTSTART:20261125T020000Z
DTEND:20261125T030000Z
SUMMARY:全球同步会（UTC 时间写入）
DESCRIPTION:DTSTART 以 UTC 表示，显示时按本地时区换算。
END:VEVENT
BEGIN:VEVENT
UID:offsite@team.example
DTSTART;VALUE=DATE:20261211
DTEND;VALUE=DATE:20261214
SUMMARY:团建（杭州）
LOCATION:杭州
DESCRIPTION:这是一条很长的描述，用来验证 RFC 5545 的折行规则：超过 75 字节的内容行会被折成多
 行，续行以一个空格开头，解析时需要还原。
END:VEVENT
BEGIN:VTODO
UID:okr@team.example
SUMMARY:填写季度 OKR 自评
DUE;VALUE=DATE:20261130
PRIORITY:1
STATUS:NEEDS-ACTION
END:VTODO
BEGIN:VTODO
UID:contacts@team.example
SUMMARY:更新团队通讯录
DUE;TZID=Asia/Shanghai:20261125T170000
STATUS:NEEDS-ACTION
END:VTODO
BEGIN:VTODO
UID:budget@team.example
SUMMARY:提交年度预算
DUE;VALUE=DATE:20261120
STATUS:COMPLETED
COMPLETED:20261119T080000Z
END:VTODO
END:VCALENDAR
